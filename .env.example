# Copia este archivo como .env y completa los valores. .env NUNCA va a git.
# Las variables vacías cuentan como "no configurado" y se usa el valor por defecto.
# Una variable CMGI_* que el programa no conoce detiene el arranque (venga de este
# archivo o del sistema): así se atrapan los nombres mal escritos. Las variables
# de OTRAS herramientas (por ejemplo, la conexión a SQL) se ignoran.

# Carpeta raíz de los datos (bronze/, silver/, alertas/, descargas/...).
# Relativa = dentro de la carpeta del proyecto. Tiene que existir: ningún comando
# la crea (salvo `cmg migrar-historico`). En un equipo nuevo, créala una vez:
#     mkdir data
CMGI_DATA_DIR=data
